# OGU account credentials
OGU_USERNAME=
OGU_PASSWORD=
# Base32 TOTP secret, only if the account has 2FA enabled
OGU_2FA_SECRET=

# 1 = bump all Market threads on your profile
# 2 = bump the links in THREAD_URLS
# 3 = award farmer, spams random facts in THREAD
MODE=2

# Comma-separated thread links, used by MODE=2
THREAD_URLS=https://oguser.com/Thread-Example-One,https://oguser.com/Thread-Example-Two

# Single thread link, used by MODE=3
THREAD=

# Hours between bump cycles
BUMP_INTERVAL_HOURS=2

HEADLESS=true
